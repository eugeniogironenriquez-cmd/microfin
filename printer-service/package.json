{
  "name": "printer-service",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "npx ts-node src/main.ts",
    "build": "npx tsc",
    "start": "node dist/main.js",
    "exe": "npm run build && npx pkg . --out-path release"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "iconv-lite": "^0.7.2",
    "node-thermal-printer": "^4.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "pkg": "^5.8.1",
    "typescript": "^6.0.3"
  },
  "bin": "dist/main.js",
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "release"
  }
}
